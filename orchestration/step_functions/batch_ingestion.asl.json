{
  "Comment": "Batch ingestion (ADR 0040, ADR 0044): run one allow-listed ingestion task in the task runner container on ECS Fargate, as the ingestion role; after a USAspending ingestion or re-sweep, apply the pending batches to Silver (Glue). Input: {\"task\": \"ingest-usaspending\" | \"resweep-usaspending\" | \"ingest-canada-contracts\"}. Fails, and alerts, unless every step succeeds.",
  "StartAt": "ValidateInput",
  "States": {
    "ValidateInput": {
      "Type": "Choice",
      "Choices": [
        {
          "Or": [
            { "Variable": "$.task", "StringEquals": "ingest-usaspending" },
            { "Variable": "$.task", "StringEquals": "resweep-usaspending" },
            { "Variable": "$.task", "StringEquals": "ingest-canada-contracts" }
          ],
          "Next": "RunIngestion"
        }
      ],
      "Default": "BadInput"
    },
    "RunIngestion": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "Cluster": "${cluster_arn}",
        "TaskDefinition": "${task_definition_arn}",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["${subnet_a}", "${subnet_b}"],
            "SecurityGroups": ["${security_group_id}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "task",
              "Environment": [
                { "Name": "PROCURELAKE_TASK", "Value.$": "$.task" },
                { "Name": "PROCURELAKE_RUN_ID", "Value.$": "$$.Execution.Name" }
              ]
            }
          ]
        }
      },
      "ResultSelector": {
        "TaskArn.$": "$.TaskArn",
        "StopCode.$": "$.StopCode",
        "Containers.$": "$.Containers"
      },
      "ResultPath": "$.ingestion",
      "Retry": [
        {
          "Comment": "Capacity or API errors before the task ran. A failed ingestion is not retried here: the next scheduled run fills the gap (the connectors are gap-filling and create-only).",
          "ErrorEquals": ["ECS.AmazonECSException", "AmazonECS.Unknown"],
          "IntervalSeconds": 30,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Alert" }],
      "Next": "CheckExitCode"
    },
    "CheckExitCode": {
      "Comment": "Do not rely on the integration failing on a non-zero exit: check it.",
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            { "Variable": "$.ingestion.Containers[0].ExitCode", "IsPresent": true },
            { "Variable": "$.ingestion.Containers[0].ExitCode", "NumericEquals": 0 }
          ],
          "Next": "NeedsSilver"
        }
      ],
      "Default": "Alert"
    },
    "NeedsSilver": {
      "Comment": "USAspending batches go on to Silver (ADR 0044); the Canada contracts CSV is Bronze only (open question 34 covers USAspending).",
      "Type": "Choice",
      "Choices": [
        {
          "Or": [
            { "Variable": "$.task", "StringEquals": "ingest-usaspending" },
            { "Variable": "$.task", "StringEquals": "resweep-usaspending" }
          ],
          "Next": "ApplyReferenceToSilver"
        }
      ],
      "Default": "Succeeded"
    },
    "ApplyReferenceToSilver": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": { "JobName": "${reference_to_silver_job_name}" },
      "ResultSelector": {
        "JobRunId.$": "$.Id",
        "JobRunState.$": "$.JobRunState",
        "ExecutionTime.$": "$.ExecutionTime"
      },
      "ResultPath": "$.silver",
      "Retry": [
        {
          "Comment": "The job is idempotent (ADR 0044). The likely error is another run of it in progress (max one concurrent run): wait and try again.",
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 300,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Alert" }],
      "Next": "Succeeded"
    },
    "Alert": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${alerts_topic_arn}",
        "Subject": "ProcureLake dev: batch ingestion failed",
        "Message.$": "States.Format('Batch ingestion task {} failed (execution {}). If the ingestion failed, the batch manifest records why (task log /procurelake/${runner_name}); if the Silver step failed, see the Glue job ${reference_to_silver_job_name} and its run summary in pipeline_runs/silver/usaspending/. Runbook: docs/runbooks/pipeline-alarms.md', $.task, $$.Execution.Name)"
      },
      "ResultPath": null,
      "Next": "IngestionFailed"
    },
    "Succeeded": { "Type": "Succeed" },
    "IngestionFailed": {
      "Type": "Fail",
      "Error": "IngestionFailed",
      "Cause": "The ingestion task did not exit 0 or did not start, or the Silver step failed (see the task log, the batch manifest in pipeline_manifests/, and the Glue run)."
    },
    "BadInput": {
      "Type": "Fail",
      "Error": "BadInput",
      "Cause": "Input must be {\"task\": \"ingest-usaspending\"}, {\"task\": \"resweep-usaspending\"} or {\"task\": \"ingest-canada-contracts\"}."
    }
  }
}
