{
  "Comment": "CDC processing (ADR 0029, ADR 0050): apply new Bronze CDC files to Silver (Glue), then build in Gold (dbt) only what is downstream of the Silver tables queued since the last successful build. Input: {\"dms_task_arn\": \"...\"}. Overlapping executions skip themselves; nothing queued skips dbt; failures notify SNS.",
  "StartAt": "CountRunningExecutions",
  "States": {
    "CountRunningExecutions": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sfn:listExecutions",
      "Parameters": {
        "StateMachineArn.$": "$$.StateMachine.Id",
        "StatusFilter": "RUNNING",
        "MaxResults": 2
      },
      "ResultSelector": { "running.$": "States.ArrayLength($.Executions)" },
      "ResultPath": "$.concurrency",
      "Next": "AnotherExecutionRunning"
    },
    "AnotherExecutionRunning": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.concurrency.running", "NumericGreaterThan": 1, "Next": "SkippedBecauseAnotherIsRunning" }
      ],
      "Default": "ApplyCdc"
    },
    "SkippedBecauseAnotherIsRunning": { "Type": "Succeed" },
    "ApplyCdc": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "${apply_cdc_job_name}",
        "Arguments": { "--dms-task-arn.$": "$.dms_task_arn" }
      },
      "ResultSelector": {
        "JobRunId.$": "$.Id",
        "JobRunState.$": "$.JobRunState",
        "ExecutionTime.$": "$.ExecutionTime"
      },
      "ResultPath": "$.cdc_apply",
      "Retry": [
        {
          "Comment": "The CDC apply is idempotent (ADR 0028), so one retry is safe.",
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 60,
          "MaxAttempts": 1,
          "BackoffRate": 2
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "NotifyFailure" }],
      "Next": "ReadGoldQueue"
    },
    "ReadGoldQueue": {
      "Comment": "The apply job queues <silver table>#<batch id> in the same DynamoDB transaction that advances each checkpoint (ADR 0050). Entries stay until a build that included them succeeds.",
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Parameters": {
        "TableName": "${checkpoint_table_name}",
        "Key": { "pk": { "S": "gold#cdc" }, "sk": { "S": "pending" } },
        "ConsistentRead": true
      },
      "ResultPath": "$.gold_queue",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "NotifyFailure" }],
      "Next": "AnythingQueued"
    },
    "AnythingQueued": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.gold_queue.Item.entries.SS", "IsPresent": true, "Next": "PrepareSelection" }
      ],
      "Default": "NothingToBuild"
    },
    "NothingToBuild": {
      "Comment": "No Silver table changed since the last successful build: Gold is current, so dbt does not run.",
      "Type": "Succeed"
    },
    "PrepareSelection": {
      "Type": "Pass",
      "Parameters": {
        "entries.$": "$.gold_queue.Item.entries.SS",
        "changed_silver.$": "States.JsonToString($.gold_queue.Item.entries.SS)"
      },
      "ResultPath": "$.selection",
      "Next": "TransformGold"
    },
    "TransformGold": {
      "Comment": "The dbt runner builds source:silver.<table>+ for the queued tables (a full build past 40 entries).",
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${dbt_state_machine_arn}",
        "Input": {
          "run_id.$": "$$.Execution.Name",
          "changed_silver.$": "$.selection.changed_silver",
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id"
        }
      },
      "ResultSelector": { "ExecutionArn.$": "$.ExecutionArn", "Status.$": "$.Status" },
      "ResultPath": "$.dbt",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "NotifyFailure" }],
      "Next": "ClearBuiltEntries"
    },
    "ClearBuiltEntries": {
      "Comment": "Remove exactly the entries this build covered. Entries queued while it ran have other batch ids and stay for the next run.",
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${checkpoint_table_name}",
        "Key": { "pk": { "S": "gold#cdc" }, "sk": { "S": "pending" } },
        "UpdateExpression": "DELETE #e :built",
        "ExpressionAttributeNames": { "#e": "entries" },
        "ExpressionAttributeValues": { ":built": { "SS.$": "$.selection.entries" } }
      },
      "ResultPath": null,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "NotifyFailure" }],
      "Next": "Succeeded"
    },
    "Succeeded": { "Type": "Succeed" },
    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${alerts_topic_arn}",
        "Subject": "ProcureLake dev: CDC processing failed",
        "Message.$": "States.Format('Execution {} failed. Error: {}', $$.Execution.Id, States.JsonToString($.error))"
      },
      "ResultPath": "$.notification",
      "Next": "Failed"
    },
    "Failed": { "Type": "Fail", "Error": "CdcProcessingFailed", "Cause": "See the execution history and the SNS notification." }
  }
}
